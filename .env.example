# Copy this file to .env. Never commit the real file.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# Storage. Set DATABASE_URL to use hosted Postgres (required for Streamlit Cloud,
# whose filesystem is wiped on every restart). Leave it unset to use local SQLite.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Local SQLite fallback. The legacy CSV is imported once on first run.
DATABASE_FILE=job_applications.db
TRACKER_FILE=applications_tracker.csv

# Processing limits and network timeout.
MAX_FILE_BYTES=5242880
MAX_PDF_PAGES=25
MAX_RESUME_CHARS=60000
MAX_JOB_CHARS=60000
OPENAI_TIMEOUT_SECONDS=90
